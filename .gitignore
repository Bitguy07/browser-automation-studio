# ============================================================
# Browser Automation Studio — .gitignore
# ============================================================

# ── Secrets — NEVER commit these ──────────────────────────────
.env

# ── Runtime data — too large / sensitive / ephemeral ─────────
# Rule: ignore everything inside data/, then selectively
# un-ignore the directory stubs we want to keep in git.
# NOTE: parent directory must be un-ignored before its contents.
data/**
!data/cookies/
!data/outputs/
!data/downloads/
!data/.gitkeep
!data/cookies/.gitkeep
!data/outputs/.gitkeep
!data/downloads/.gitkeep

# ── Backups created by setup scripts ─────────────────────────
*.bak
data_backup_*/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Node / React ─────────────────────────────────────────────
frontend/node_modules/
frontend/build/

# ── Docker ───────────────────────────────────────────────────
# Dockerfile and docker-compose.yml are intentionally NOT ignored

# ── Logs ─────────────────────────────────────────────────────
*.log
build.log

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo